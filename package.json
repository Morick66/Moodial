{
  "name": "moodial",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-host-first AI emotional diary.",
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:local": "docker compose stop app && docker compose up -d postgres && env 'DATABASE_URL=postgresql://jzmle:change-me@localhost:5432/jzmle?schema=public' npm run db:deploy && env 'DATABASE_URL=postgresql://jzmle:change-me@localhost:5432/jzmle?schema=public' npm run dev",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "db:generate": "npm run db:generate -w packages/db",
    "db:deploy": "npm run db:deploy -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:studio": "npm run db:studio -w packages/db",
    "verify:diary-crud": "node scripts/verify-diary-crud.mjs",
    "verify:docker-mvp": "node scripts/verify-docker-mvp.mjs"
  },
  "workspaces": [
    "apps/web",
    "packages/core",
    "packages/db",
    "packages/prompts"
  ],
  "overrides": {
    "kysely": "0.28.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "kysely": "0.28.8"
  }
}
