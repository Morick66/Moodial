# ============================================
# Moodial 环境变量配置
# ============================================
# 
# 说明：复制此文件为 .env，然后根据你的需求修改
# cp .env.example .env
# 
# 更多信息见：https://github.com/Morick66/Moodial/docs/public/self-hosting.md

# ============================================
# 应用配置
# ============================================

# 应用名称
APP_NAME=Moodial

# 应用访问 URL（用户访问的地址）
# 示例：http://localhost:3000 (本地开发)
#      http://your-domain.com (自部署)
#      https://your-domain.com (生产环境)
APP_URL=http://localhost:3000

# 应用监听端口
APP_PORT=3000

# Node.js 环境
# 可选值: development, production, test
NODE_ENV=development

# ============================================
# 数据库配置
# ============================================

# PostgreSQL 用户名
POSTGRES_USER=jzmle

# PostgreSQL 密码
# ⚠️ 强烈建议改为强密码！
POSTGRES_PASSWORD=change-me

# PostgreSQL 数据库名
POSTGRES_DB=jzmle

# PostgreSQL 连接字符串（自动构成，通常无需改）
# Docker 环境：postgresql://user:pass@postgres:5432/dbname
# 本地开发：postgresql://user:pass@localhost:5432/dbname
DATABASE_URL=postgresql://jzmle:change-me@postgres:5432/jzmle?schema=public

# PostgreSQL 端口
POSTGRES_PORT=5432

# ============================================
# 认证配置
# ============================================

# Session 加密密钥
# ⚠️ 强烈建议生成随机字符串！
# 生成方法：openssl rand -base64 32 (Linux/Mac)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# 是否允许公开注册
# false: 仅管理员可创建账号
# true: 任何人都可以注册
ALLOW_PUBLIC_SIGNUP=false

# 是否启用邀请模式
# true: 管理员生成邀请链接，其他人通过邀请链接注册
# false: 关闭邀请链接
INVITE_ONLY=true

# ============================================
# AI 模型配置
# ============================================

# AI 提供商
# 可选值：
#   - openai_compatible: OpenAI 兼容接口（推荐）
#   - openai: OpenAI 官方 API
#   - 其他提供商（待扩展）
AI_PROVIDER=openai_compatible

# AI API 基础 URL
# OpenAI: https://api.openai.com/v1
# 自建/本地: http://localhost:11434/v1 (Ollama)
#           http://localhost:1234/v1 (LM Studio)
AI_BASE_URL=

# AI 模型名称
# OpenAI: gpt-3.5-turbo, gpt-4, gpt-4-turbo
# Ollama: llama2, mistral, neural-chat
# LM Studio: 根据你加载的模型名称
AI_MODEL=

# AI API 密钥
# OpenAI: sk-...
# Ollama/本地模型: 可以留空（大多数本地模型不需要）
AI_API_KEY=

# ============================================
# 官方托管配置（仅用于官方服务）
# ============================================

# 是否启用计费系统
# false: 自部署模式，不启用计费
# true: 官方托管模式，启用计费
BILLING_ENABLED=false

# 免费额度（月）
# 单位：API tokens 调用次数
# 例如：100000 表示每月 10 万 tokens 免费
FREE_AI_CREDITS=0

# ============================================
# 公开客户端配置
# ============================================

# 前端显示的应用名称
NEXT_PUBLIC_APP_NAME=Moodial

# ============================================
# 可选：Docker Compose 容器名
# ============================================

# 应用容器名称（Docker）
# APP_CONTAINER_NAME=moodial

# PostgreSQL 容器名称（Docker）
# POSTGRES_CONTAINER_NAME=moodial-postgres

# ============================================
# 开发和调试（可选）
# ============================================

# 调试模式
# DEBUG=prisma:client

# 日志级别
# LOG_LEVEL=info

# ============================================
# 配置说明
# ============================================
#
# 自部署注意事项：
# 1. 改变 POSTGRES_PASSWORD 为强密码
# 2. 改变 BETTER_AUTH_SECRET 为随机字符串
# 3. 配置 AI_PROVIDER、AI_BASE_URL、AI_API_KEY
#    - 本地模型（最隐私）：使用 Ollama/LM Studio
#    - 云端模型（更方便）：使用 OpenAI 等
# 4. 如需公网访问，改变 APP_URL 为你的域名
#
# 模型选择建议：
# - 隐私优先：使用 Ollama + Llama2/Mistral（本地）
# - 效果优先：使用 OpenAI + GPT-3.5/GPT-4
# - 折中方案：使用国内大模型（需要 API Key）
#
# 遇到问题？
# 文档：https://github.com/Morick66/Moodial/docs
# 问题讨论：https://github.com/Morick66/Moodial/discussions
# Bug 报告：https://github.com/Morick66/Moodial/issues
